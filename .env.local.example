# Law4Us Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# REQUIRED: Google Drive Integration
# ===========================================
# Google Drive Service Account Email
# Get this from Google Cloud Console -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Google Drive Service Account Private Key
# Get this from Google Cloud Console -> Service Accounts -> Keys
# IMPORTANT: Replace \n with actual newlines in the private key
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Drive Folder ID where submissions will be stored
# Create a folder in Google Drive and copy the ID from the URL
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# ===========================================
# REQUIRED: Email Configuration (Google Workspace SMTP)
# ===========================================
# Email SMTP Server (Gmail/Google Workspace)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Google Workspace email address for sending emails
EMAIL_USER=info@law-4-us.co.il

# Google Workspace App Password (NOT your regular password!)
# How to generate:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in with info@law-4-us.co.il
# 3. Create new app password for "Mail"
# 4. Copy the 16-character password
EMAIL_PASSWORD=your-16-char-app-password

# Email addresses for sending and receiving
# Using the same email for all since we only have one Google Workspace account
EMAIL_FROM=info@law-4-us.co.il
EMAIL_TO=info@law-4-us.co.il

# ===========================================
# REQUIRED: AI & Document Generation
# ===========================================
# Groq API Key for AI text transformation (custody/alimony claims)
# Get this from https://console.groq.com/keys (FREE tier available)
GROQ_API_KEY=your_groq_api_key_here

# Lawyer Signature File ID (Google Drive)
# The signature is stored in Google Drive to avoid the 65KB env var limit
# To get this: Run `npx tsx scripts/upload-signature-to-drive.ts`
# This will upload Signature.png to Google Drive and give you the file ID
LAWYER_SIGNATURE_FILE_ID=your-file-id-here

# ===========================================
# REQUIRED: File Uploads (Vercel Blob)
# ===========================================
# Required for direct uploads from the wizard file fields
# Get this from Vercel Dashboard -> Storage -> Blob -> .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Public Vercel Blob URL for the homepage explainer video
NEXT_PUBLIC_HOMEPAGE_VIDEO_URL=https://your-store.public.blob.vercel-storage.com/homepage/law4us-homepage-video.mp4

# Cal.com event slugs. Keep the introductory call separate from the post-payment identity call.
NEXT_PUBLIC_INITIAL_CONSULTATION_CAL_LINK=law4us/advice
NEXT_PUBLIC_CAL_LINK=law4us/video-verification

# ===========================================
# REQUIRED: Application Configuration
# ===========================================
# Base URL of your application (for generating recovery links, etc.)
# Development: http://localhost:3000
# Production: https://law-4-us.co.il (or your actual domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# REQUIRED: Payments (Grow via Make)
# ===========================================
# Server-side Make webhook that creates a Grow payment link and returns its URL.
MAKE_PAYMENT_LINK_WEBHOOK_URL=https://hook.eu2.make.com/your-create-payment-link-webhook

# Optional server-only override for live payment testing from local development.
# Grow return URLs must be public HTTPS URLs, such as a Vercel preview deployment.
# PAYMENT_RETURN_BASE_URL=https://your-preview-domain.vercel.app

# Required in production: shared secret for Make -> Law4Us payment confirmation webhooks.
# Configure the same value in Make as the x-law4us-payment-secret header.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ===========================================
# OPTIONAL: Legacy (Not needed for Vercel-only deployment)
# ===========================================
# Backend URL - Only needed if using Railway backend (deprecated)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ===========================================
# OPTIONAL: CMS & Analytics
# ===========================================
# Tina CMS Configuration (for blog management)
# Sign up at https://app.tina.io/register (FREE forever!)
# Create a new project and get your credentials
NEXT_PUBLIC_TINA_CLIENT_ID=your-client-id-here
TINA_TOKEN=your-token-here
NEXT_PUBLIC_TINA_BRANCH=main

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Other integrations
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_HOTJAR_ID=
